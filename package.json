{
  "name": "expose",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive 3D globe showing how powerful people, companies, funds and governments are connected, backed by public sources.",
  "scripts": {
    "predev": "node tools/gen-land.mjs && node tools/gen-geo.mjs",
    "dev": "vite",
    "prebuild": "node tools/gen-land.mjs && node tools/gen-geo.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "data": "node scripts/build-data.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/oxanium": "^5.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/three": "^0.187.0",
    "@types/topojson-client": "^3.1.5",
    "d3-geo": "^3.1.2",
    "topojson-client": "^3.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "world-atlas": "^2.0.2"
  }
}
